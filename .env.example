# Copy this file to .env (in the repository root) and fill in your values
#   Windows: copy .env.example .env      Linux/macOS: cp .env.example .env

# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitness

# Secret key for signing JWT login tokens (change in production!)
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Login token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# "development" or "production". In production the app refuses to start with a weak SECRET_KEY.
ENVIRONMENT=development

# Origins allowed to call the API directly from a browser (comma-separated).
# Not needed when the frontend uses the dev proxy.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
