# Copy this file to .env (in the repository root) and fill in your local values:
#   Windows: copy .env.example .env      Linux/macOS: cp .env.example .env
# Never commit .env or store real production secrets in version control.

# ---------------------------------------------------------------------------
# PostgreSQL Administrator / Migration Credentials
# Used by Docker Compose to initialize PostgreSQL and by Alembic migrations.
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-admin-db-password
POSTGRES_DB=fitness

# ---------------------------------------------------------------------------
# PostgreSQL Runtime Application Role (Least-Privilege)
# Used by the FastAPI application at runtime (NOSUPERUSER, no DDL privileges).
# Configured automatically by `python scripts/configure_db_roles.py` or Docker Compose.
# ---------------------------------------------------------------------------
APP_DB_USER=app_user
APP_DB_PASSWORD=replace-with-local-app-db-password

# ---------------------------------------------------------------------------
# SQLAlchemy Connection URLs
# DATABASE_URL: runtime connection string used by FastAPI (`app/db/session.py`).
# DATABASE_MIGRATION_URL (optional): admin/owner connection string used by Alembic
#   and `scripts/setup_db.py`. If omitted in local dev, falls back to DATABASE_URL.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://app_user:replace-with-local-app-db-password@localhost:5432/fitness
DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres:replace-with-local-admin-db-password@localhost:5432/fitness

# ---------------------------------------------------------------------------
# JWT & Application Security
# Generate a strong SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# "development" or "production". In production the app refuses to start with a weak SECRET_KEY.
ENVIRONMENT=development

# Comma-separated list of origins allowed to call the API directly from a browser.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional (Docker Compose only): set to "true" to load fictional demo data from database/seed.sql
SEED_DB=false
